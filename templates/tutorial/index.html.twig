{% extends "base.html.twig" %}

{% block title %}Tutoriels - Micro-Learning{% endblock %}

{% block body %}
<div class="py-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-4xl font-bold text-gray-900">Tutoriels</h1>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_tutorial_create') }}" class="bg-indigo-600 text-white px-6 py-2 rounded-md hover:bg-indigo-700 font-medium">
                + Créer un tutoriel
            </a>
        {% endif %}
    </div>

    {% if tutorials is empty %}
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <p class="text-gray-500 text-lg">Aucun tutoriel disponible pour le moment.</p>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_tutorial_create') }}" class="mt-4 inline-block text-indigo-600 hover:text-indigo-700 font-medium">
                    Créez le premier! →
                </a>
            {% endif %}
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for tutorial in tutorials %}
                <div class="bg-white rounded-lg shadow hover:shadow-lg transition-shadow overflow-hidden">
                    <div class="p-6">
                        <div class="flex items-start justify-between mb-2">
                            <h2 class="text-xl font-bold text-gray-900 flex-1">
                                {{ tutorial.title }}
                            </h2>
                            <span class="inline-block px-3 py-1 ml-2 text-xs font-semibold rounded-full
                                {% if tutorial.status == 'published' %}bg-green-100 text-green-800{% endif %}
                                {% if tutorial.status == 'draft' %}bg-yellow-100 text-yellow-800{% endif %}
                                {% if tutorial.status == 'review' %}bg-blue-100 text-blue-800{% endif %}
                                {% if tutorial.status == 'rejected' %}bg-red-100 text-red-800{% endif %}
                            ">
                                {{ tutorial.status|upper }}
                            </span>
                        </div>
                        
                        <p class="text-sm text-gray-500 mb-3">
                            Par <strong>{{ tutorial.author.firstName }} {{ tutorial.author.lastName }}</strong>
                            • {{ tutorial.createdAt.format('d M Y') }}
                        </p>

                        {% if tutorial.category %}
                            <p class="text-xs text-indigo-600 mb-3 font-medium">{{ tutorial.category|upper }}</p>
                        {% endif %}

                        <p class="text-gray-700 mb-4 line-clamp-3">{{ tutorial.description }}</p>

                        <div class="text-sm text-gray-500 mb-4">
                            <strong>{{ tutorial.steps|length }}</strong> étape{{ tutorial.steps|length > 1 ? 's' : '' }}
                        </div>

                        <a href="{{ path('app_tutorial_show', { id: tutorial.id }) }}" class="inline-block text-indigo-600 hover:text-indigo-700 font-medium">
                            Voir le tutoriel →
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
