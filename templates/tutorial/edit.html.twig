{% extends "base.html.twig" %}

{% block title %}Éditer "{{ tutorial.title }}" - Micro-Learning{% endblock %}

{% block body %}
<div class="py-6">
    <div class="mb-6">
        <a href="{{ path('app_tutorial_show', { id: tutorial.id }) }}" class="text-indigo-600 hover:text-indigo-700 font-medium">
            ← Retour au tutoriel
        </a>
    </div>

    <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Éditer le tutoriel</h1>
        <p class="text-gray-600 mb-8">Statut actuel: <span class="font-semibold text-indigo-600">{{ tutorial.status|upper }}</span></p>

        <div class="bg-white rounded-lg shadow p-8">
            {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {% if form.title.vars.errors|length > 0 %}
                    <div class="mt-2 text-red-600 text-sm">
                        {{ form_errors(form.title) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {% if form.description.vars.errors|length > 0 %}
                    <div class="mt-2 text-red-600 text-sm">
                        {{ form_errors(form.description) }}
                    </div>
                {% endif %}
            </div>

            <div>
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                {% if form.category.vars.errors|length > 0 %}
                    <div class="mt-2 text-red-600 text-sm">
                        {{ form_errors(form.category) }}
                    </div>
                {% endif %}
            </div>

            <div class="border-t pt-8">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">Étapes du tutoriel</h2>
                    <button type="button" data-action="tutorial-add-step" class="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 font-medium text-sm">
                        + Ajouter une étape
                    </button>
                </div>

                <template id="step-prototype">
                    {{ form_widget(form.steps.vars.prototype)|raw }}
                </template>

                <div data-collection-wrapper="steps" class="space-y-6">
                    {% for stepForm in form.steps %}
                        <div class="bg-gray-50 rounded-lg p-6 border-2 border-dashed border-gray-300 step-item" data-position="{{ loop.index0 }}">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">Étape {{ loop.index }}</h3>
                                <button type="button" data-action="tutorial-remove-step" class="text-red-600 hover:text-red-700 text-sm font-medium">
                                    Supprimer
                                </button>
                            </div>

                            <div class="space-y-4">
                                <div>
                                    {{ form_label(stepForm.title) }}
                                    {{ form_widget(stepForm.title) }}
                                    {% if stepForm.title.vars.errors|length > 0 %}
                                        <div class="mt-2 text-red-600 text-sm">
                                            {{ form_errors(stepForm.title) }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div>
                                    {{ form_label(stepForm.content) }}
                                    {{ form_widget(stepForm.content) }}
                                    {% if stepForm.content.vars.errors|length > 0 %}
                                        <div class="mt-2 text-red-600 text-sm">
                                            {{ form_errors(stepForm.content) }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div>
                                    {{ form_label(stepForm.codeExample) }}
                                    {{ form_widget(stepForm.codeExample) }}
                                    {% if stepForm.codeExample.vars.errors|length > 0 %}
                                        <div class="mt-2 text-red-600 text-sm">
                                            {{ form_errors(stepForm.codeExample) }}
                                        </div>
                                    {% endif %}
                                </div>

                                <div>
                                    {{ form_label(stepForm.position) }}
                                    {{ form_widget(stepForm.position) }}
                                    {% if stepForm.position.vars.errors|length > 0 %}
                                        <div class="mt-2 text-red-600 text-sm">
                                            {{ form_errors(stepForm.position) }}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="flex space-x-4 pt-8">
                {{ form_widget(form.save) }}
                <a href="{{ path('app_tutorial_show', { id: tutorial.id }) }}" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 font-medium">
                    Annuler
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
function initTutorialStepCollection() {
    const addButton = document.querySelector('[data-action="tutorial-add-step"]');
    const wrapper = document.querySelector('[data-collection-wrapper="steps"]');
    const prototypeTemplate = document.getElementById('step-prototype');
    if (!wrapper || !addButton || !prototypeTemplate) {
        return;
    }

    if (wrapper.dataset.tutorialStepsInitialized === 'true') {
        return;
    }
    wrapper.dataset.tutorialStepsInitialized = 'true';

    const prototype = prototypeTemplate.innerHTML;
    if (!prototype) {
        return;
    }

    let stepIndex = wrapper.querySelectorAll('.step-item').length;

    addButton.addEventListener('click', function(e) {
        e.preventDefault();

        const newForm = document.createElement('div');
        newForm.className = 'bg-gray-50 rounded-lg p-6 border-2 border-dashed border-gray-300 step-item';
        newForm.dataset.position = stepIndex;
        newForm.innerHTML = `
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Étape ${stepIndex + 1}</h3>
                <button type="button" data-action="tutorial-remove-step" class="text-red-600 hover:text-red-700 text-sm font-medium">Supprimer</button>
            </div>
            <div class="space-y-4">
                ${prototype.replace(/__name__/g, stepIndex)}
            </div>
        `;

        wrapper.appendChild(newForm);
        attachRemoveListener(newForm.querySelector('[data-action="tutorial-remove-step"]'));
        stepIndex++;
    });

    function attachRemoveListener(button) {
        if (!button) {
            return;
        }

        button.addEventListener('click', function(e) {
            e.preventDefault();
            this.closest('.step-item').remove();
            updateStepNumbers();
        });
    }

    function updateStepNumbers() {
        wrapper.querySelectorAll('.step-item').forEach((item, index) => {
            const heading = item.querySelector('h3');
            if (heading) {
                heading.textContent = `Étape ${index + 1}`;
            }
        });
    }

    wrapper.querySelectorAll('[data-action="tutorial-remove-step"]').forEach(attachRemoveListener);
}

document.addEventListener('DOMContentLoaded', initTutorialStepCollection);
document.addEventListener('turbo:load', initTutorialStepCollection);
</script>
{% endblock %}
