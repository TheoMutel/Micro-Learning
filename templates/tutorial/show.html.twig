{% extends "base.html.twig" %}

{% block title %}{{ tutorial.title }} - Micro-Learning{% endblock %}

{% block body %}
<div class="py-6">
    <div class="mb-6">
        <a href="{{ path('app_tutorial_index') }}" class="text-indigo-600 hover:text-indigo-700 font-medium">
            ← Retour aux tutoriels
        </a>
    </div>

    <div class="bg-white rounded-lg shadow p-8 mb-6">
        <div class="flex items-start justify-between mb-4">
            <div class="flex-1">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ tutorial.title }}</h1>
                <p class="text-gray-600 mb-4">{{ tutorial.description }}</p>
            </div>
            <span class="inline-block px-4 py-2 text-sm font-semibold rounded-full
                {% if tutorial.status == 'published' %}bg-green-100 text-green-800{% endif %}
                {% if tutorial.status == 'draft' %}bg-yellow-100 text-yellow-800{% endif %}
                {% if tutorial.status == 'review' %}bg-blue-100 text-blue-800{% endif %}
                {% if tutorial.status == 'rejected' %}bg-red-100 text-red-800{% endif %}
            ">
                {{ tutorial.status|upper }}
            </span>
        </div>

        <div class="flex items-center space-x-6 text-sm text-gray-500 mb-6 pb-6 border-b">
            <div>
                <strong>Auteur:</strong> {{ tutorial.author.firstName }} {{ tutorial.author.lastName }}
            </div>
            <div>
                <strong>Créé:</strong> {{ tutorial.createdAt.format('d M Y H:i') }}
            </div>
            {% if tutorial.updatedAt %}
                <div>
                    <strong>Modifié:</strong> {{ tutorial.updatedAt.format('d M Y H:i') }}
                </div>
            {% endif %}
            {% if tutorial.category %}
                <div>
                    <strong>Catégorie:</strong> {{ tutorial.category }}
                </div>
            {% endif %}
        </div>

        {% if is_granted('tutorial_edit', tutorial) or is_granted('tutorial_submit_review', tutorial) %}
        <div class="flex space-x-3">
            {% if is_granted('tutorial_edit', tutorial) %}
                <a href="{{ path('app_tutorial_edit', { id: tutorial.id }) }}" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 font-medium">
                    ✏️ Modifier
                </a>
            {% endif %}
            
            {% if is_granted('tutorial_submit_review', tutorial) %}
                <form method="post" action="{{ path('app_tutorial_submit_review', { id: tutorial.id }) }}" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit' ~ tutorial.id) }}">
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 font-medium">
                        → Soumettre pour révision
                    </button>
                </form>
            {% endif %}

            {% if is_granted('tutorial_delete', tutorial) %}
                <form method="post" action="{{ path('app_tutorial_delete', { id: tutorial.id }) }}" style="display:inline" onsubmit="return confirm('Êtes-vous sûr?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tutorial.id) }}">
                    <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 font-medium">
                        🗑️ Supprimer
                    </button>
                </form>
            {% endif %}
        </div>
        {% endif %}

        {% if tutorial.rejectionReason and tutorial.status == 'rejected' %}
            <div class="mt-6 p-4 bg-red-50 border border-red-200 rounded-md">
                <h3 class="font-semibold text-red-800 mb-2">Raison du rejet</h3>
                <p class="text-red-700">{{ tutorial.rejectionReason }}</p>
            </div>
        {% endif %}
    </div>

    {% if tutorial.steps|length > 0 %}
        <div class="space-y-6">
            {% for step in tutorial.steps %}
                <div class="bg-white rounded-lg shadow p-8">
                    <div class="flex items-start space-x-4 mb-4">
                        <div class="flex-shrink-0 w-10 h-10 bg-indigo-600 text-white rounded-full flex items-center justify-center font-bold">
                            {{ loop.index }}
                        </div>
                        <div class="flex-1">
                            <h2 class="text-2xl font-bold text-gray-900">{{ step.title }}</h2>
                        </div>
                    </div>

                    <div class="prose prose-sm max-w-none text-gray-700 mb-6">
                        {{ step.content|nl2br }}
                    </div>

                    {% if step.codeExample %}
                        <div class="bg-gray-900 rounded-lg p-4 mb-6">
                            <p class="text-xs text-gray-400 mb-2 font-semibold">Code Example</p>
                            <pre class="text-gray-100 text-sm overflow-auto"><code>{{ step.codeExample }}</code></pre>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
