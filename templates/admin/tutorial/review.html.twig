{% extends "base.html.twig" %}

{% block title %}Révision: {{ tutorial.title }} - Admin{% endblock %}

{% block body %}
<div class="py-6">
    <div class="mb-6">
        <a href="{{ path('app_admin_tutorial_review_list') }}" class="text-indigo-600 hover:text-indigo-700 font-medium">
            ← Retour à la liste
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main content -->
        <div class="lg:col-span-2">
            <!-- Tutoriel overview -->
            <div class="bg-white rounded-lg shadow p-8 mb-6">
                <div class="flex items-start justify-between mb-6 pb-6 border-b">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900 mb-2">{{ tutorial.title }}</h1>
                        <p class="text-sm text-gray-600">
                            Par <strong>{{ tutorial.author.firstName }} {{ tutorial.author.lastName }}</strong>
                            ({{ tutorial.author.email }})
                        </p>
                    </div>
                    <span class="inline-block px-3 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">
                        EN RÉVISION
                    </span>
                </div>

                <div class="space-y-4 mb-6">
                    <div>
                        <h3 class="text-sm font-semibold text-gray-700">Description</h3>
                        <p class="text-gray-700 mt-2">{{ tutorial.description }}</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700">Catégorie</h3>
                            <p class="text-gray-700 mt-1">{{ tutorial.category|capitalize }}</p>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700">Étapes</h3>
                            <p class="text-gray-700 mt-1">{{ tutorial.steps|length }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Steps preview -->
            {% if tutorial.steps|length > 0 %}
                <div class="space-y-6 mb-6">
                    {% for step in tutorial.steps %}
                        <div class="bg-white rounded-lg shadow p-8">
                            <div class="flex items-start space-x-4 mb-4">
                                <div class="flex-shrink-0 w-10 h-10 bg-indigo-200 text-indigo-800 rounded-full flex items-center justify-center font-bold">
                                    {{ loop.index }}
                                </div>
                                <div class="flex-1">
                                    <h3 class="text-lg font-semibold text-gray-900">{{ step.title }}</h3>
                                </div>
                            </div>

                            <div class="prose prose-sm max-w-none text-gray-700 mb-4">
                                {{ step.content|nl2br }}
                            </div>

                            {% if step.codeExample %}
                                <div class="bg-gray-900 rounded-lg p-4">
                                    <p class="text-xs text-gray-400 mb-2 font-semibold">Code Example</p>
                                    <pre class="text-gray-100 text-xs overflow-auto"><code>{{ step.codeExample }}</code></pre>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <!-- Actions sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow sticky top-6">
                <div class="p-6">
                    <h2 class="text-lg font-bold text-gray-900 mb-6">Actions</h2>

                    <!-- Approve -->
                    <form method="post" action="{{ path('app_admin_tutorial_approve', { id: tutorial.id }) }}" class="mb-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ tutorial.id) }}">
                        <button type="submit" class="w-full bg-green-600 text-white px-4 py-3 rounded-md hover:bg-green-700 font-medium rounded-lg">
                            ✅ Approuver et publier
                        </button>
                    </form>

                    <!-- Reject -->
                    <form method="post" action="{{ path('app_admin_tutorial_reject', { id: tutorial.id }) }}" class="border-t pt-6">
                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ tutorial.id) }}">

                        <h3 class="font-semibold text-gray-900 mb-3">Raison du rejet</h3>
                        <textarea name="rejection_reason" rows="4" placeholder="Expliquez pourquoi ce tutoriel est rejeté..." class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 mb-4" required></textarea>

                        <button type="submit" class="w-full bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 font-medium">
                            ❌ Confirmer le rejet
                        </button>
                    </form>

                <!-- Info panel -->
                <div class="border-t p-6 bg-gray-50">
                    <h3 class="font-semibold text-gray-900 mb-3">Informations</h3>
                    <dl class="text-sm space-y-2">
                        <div>
                            <dt class="text-gray-600">Soumis le</dt>
                            <dd class="font-medium text-gray-900">{{ tutorial.createdAt.format('d M Y à H:i') }}</dd>
                        </div>
                        <div>
                            <dt class="text-gray-600">Modifié le</dt>
                            <dd class="font-medium text-gray-900">{{ tutorial.updatedAt.format('d M Y à H:i') }}</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
