{% extends "base.html.twig" %}

{% block title %}Tous les tutoriels - Admin{% endblock %}

{% block body %}
<div class="py-6">
    <h1 class="text-4xl font-bold text-gray-900 mb-8">Tous les tutoriels</h1>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Titre</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Auteur</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Catégorie</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Étapes</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Créé</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for tutorial in tutorials %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <h3 class="text-sm font-medium text-gray-900">{{ tutorial.title }}</h3>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ tutorial.author.firstName }} {{ tutorial.author.lastName }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ tutorial.category|capitalize }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-block px-2 py-1 text-xs font-semibold rounded-full
                                {% if tutorial.status == 'published' %}bg-green-100 text-green-800{% endif %}
                                {% if tutorial.status == 'draft' %}bg-yellow-100 text-yellow-800{% endif %}
                                {% if tutorial.status == 'review' %}bg-blue-100 text-blue-800{% endif %}
                                {% if tutorial.status == 'rejected' %}bg-red-100 text-red-800{% endif %}
                            ">
                                {{ tutorial.status|upper }}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ tutorial.steps|length }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            {{ tutorial.createdAt.format('d M Y') }}
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <a href="{{ path('app_tutorial_show', { id: tutorial.id }) }}" class="text-indigo-600 hover:text-indigo-900">
                                Voir
                            </a>
                            {% if tutorial.status == 'review' %}
                                <a href="{{ path('app_admin_tutorial_review', { id: tutorial.id }) }}" class="ml-4 text-blue-600 hover:text-blue-900">
                                    Réviser
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if tutorials is empty %}
        <div class="text-center py-12">
            <p class="text-gray-500">Aucun tutoriel trouvé.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
