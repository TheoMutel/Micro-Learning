<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Micro-Learning Platform{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        {% block stylesheets %}
            <script src="https://cdn.tailwindcss.com"></script>
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-slate-50 text-slate-900">
        <nav class="bg-white shadow">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex">
                        <div class="flex-shrink-0 flex items-center">
                            <a href="{{ path('app_tutorial_index') }}" class="text-2xl font-bold text-indigo-600">📚 Micro-Learning</a>
                        </div>
                        <div class="hidden md:block">
                            <div class="ml-10 flex space-x-4">
                                <a href="{{ path('app_tutorial_index') }}" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">Tutoriels</a>
                                {% if is_granted('ROLE_USER') %}
                                    <a href="{{ path('app_tutorial_create') }}" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">Créer</a>
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_admin_tutorial_review_list') }}" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">Modération</a>
                                    <a href="{{ path('app_admin_tutorial_list') }}" class="text-gray-600 hover:text-indigo-600 px-3 py-2 rounded-md text-sm font-medium">Admin</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        {% if app.user %}
                            <span class="text-sm text-gray-700">{{ app.user.firstName }}</span>
                            <a href="{{ path('app_logout') }}" class="text-gray-600 hover:text-indigo-600 text-sm font-medium">Déconnexion</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-indigo-600 text-sm font-medium">Connexion</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>

        <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
            {% for label, messages in app.flashes %}
                <div class="mb-4 p-4 rounded-md 
                    {% if label == 'success' %}bg-green-50 border border-green-200{% endif %}
                    {% if label == 'error' %}bg-red-50 border border-red-200{% endif %}
                    {% if label == 'warning' %}bg-yellow-50 border border-yellow-200{% endif %}
                ">
                    {% for message in messages %}
                        <p class="text-sm font-medium
                            {% if label == 'success' %}text-green-800{% endif %}
                            {% if label == 'error' %}text-red-800{% endif %}
                            {% if label == 'warning' %}text-yellow-800{% endif %}
                        ">{{ message }}</p>
                    {% endfor %}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </body>
</html>
