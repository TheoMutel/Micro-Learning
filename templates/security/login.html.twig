{% extends 'base.html.twig' %}

{% block title %}Connexion - Micro-Learning{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-slate-50">
    <div class="w-full max-w-md space-y-8 bg-white rounded-3xl shadow-xl p-10">
        <div>
            <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-slate-900">Connectez-vous à votre compte</h2>
            <p class="mt-2 text-center text-sm text-slate-500">Entrez vos identifiants pour accéder à la plateforme.</p>
        </div>

        {% if error %}
            <div class="rounded-2xl bg-red-50 border border-red-200 p-4 text-sm text-red-700">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form class="mt-8 space-y-6" action="{{ path('app_login') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="rounded-3xl shadow-sm -space-y-px">
                <div>
                    <label for="inputEmail" class="sr-only">Email</label>
                    <input id="inputEmail" name="email" type="email" autocomplete="email" required autofocus value="{{ last_username }}" class="relative block w-full rounded-t-3xl border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 focus:z-10 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" placeholder="Email">
                </div>
                <div>
                    <label for="inputPassword" class="sr-only">Mot de passe</label>
                    <input id="inputPassword" name="password" type="password" autocomplete="current-password" required class="relative block w-full rounded-b-3xl border border-slate-300 px-4 py-3 text-slate-900 placeholder-slate-400 focus:z-10 focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" placeholder="Mot de passe">
                </div>
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input id="remember_me" name="_remember_me" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="remember_me" class="ml-2 block text-sm text-slate-600">Se souvenir de moi</label>
                </div>
            </div>

            <div>
                <button type="submit" class="group relative flex w-full justify-center rounded-3xl bg-indigo-600 py-3 px-4 text-sm font-semibold text-white hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    Connexion
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
